<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thaer Media Admin</title><link rel="stylesheet" href="/admin.css"></head><body>
<header class="admin-top"><b>Thaer Media CMS</b><div><a href="/" target="_blank">عرض الموقع ↗</a><form method="post" action="/admin/logout" style="display:inline"><button>خروج</button></form></div></header>
<div class="admin-layout"><aside><a href="#settings">⚙️ الإعدادات</a><a href="#services">🧩 الخدمات</a><a href="#portfolio">🖼️ الأعمال</a><a href="#pages">📄 الصفحات</a><a href="#social">🔗 السوشيال</a></aside><main class="dashboard">
<section id="settings" class="panel"><h2>الهوية والإعدادات</h2><form method="post" action="/admin/settings" class="form-grid">
<% Object.entries(s).forEach(([k,v])=>{ if(k==='logo'||k==='favicon') return; %><label><span><%=k%></span><input name="<%=k%>" value="<%=v%>"></label><% }) %><button class="save">حفظ الإعدادات</button></form><hr><form method="post" action="/admin/upload/logo" enctype="multipart/form-data"><label>رفع الشعار<input type="file" name="file" accept="image/*" required></label><button class="save">رفع</button></form><%if(s.logo){%><img class="logo-preview" src="<%=s.logo%>"><%}%></section>

<section id="services" class="panel"><h2>الخدمات</h2><form method="post" action="/admin/services/save" class="card-form"><input name="title_ar" placeholder="العنوان عربي" required><input name="title_en" placeholder="Title English" required><textarea name="description_ar" placeholder="الوصف عربي"></textarea><textarea name="description_en" placeholder="Description English"></textarea><input name="sort_order" type="number" value="1"><button class="save">إضافة خدمة</button></form><div class="rows"><%services.forEach(x=>{%><details><summary><%=x.title_ar%></summary><form method="post" action="/admin/services/save" class="card-form"><input type="hidden" name="id" value="<%=x.id%>"><input name="title_ar" value="<%=x.title_ar%>"><input name="title_en" value="<%=x.title_en%>"><textarea name="description_ar"><%=x.description_ar%></textarea><textarea name="description_en"><%=x.description_en%></textarea><input name="sort_order" type="number" value="<%=x.sort_order%>"><label><input type="checkbox" name="visible" <%=x.visible?'checked':''%>> ظاهر</label><button class="save">حفظ</button></form><form method="post" action="/admin/services/delete"><input type="hidden" name="id" value="<%=x.id%>"><button class="danger">حذف</button></form></details><%})%></div></section>

<section id="portfolio" class="panel"><h2>الأعمال</h2><form method="post" action="/admin/portfolio/save" class="card-form"><input name="title" placeholder="اسم المشروع" required><input name="category" placeholder="التصنيف"><input name="description" placeholder="الوصف"><input name="image" placeholder="رابط الصورة"><input name="url" placeholder="رابط المشروع"><button class="save">إضافة</button></form><div class="rows"><%portfolio.forEach(x=>{%><details><summary><%=x.title%></summary><form method="post" action="/admin/portfolio/save" class="card-form"><input type="hidden" name="id" value="<%=x.id%>"><input name="title" value="<%=x.title%>"><input name="category" value="<%=x.category%>"><input name="description" value="<%=x.description%>"><input name="image" value="<%=x.image%>"><input name="url" value="<%=x.url%>"><button class="save">حفظ</button></form><form method="post" action="/admin/portfolio/delete"><input type="hidden" name="id" value="<%=x.id%>"><button class="danger">حذف</button></form></details><%})%></div></section>

<section id="pages" class="panel"><h2>الصفحات الجانبية</h2><form method="post" action="/admin/pages/save" class="card-form"><input name="slug" placeholder="slug مثال: privacy" required><input name="title_ar" placeholder="العنوان عربي"><input name="title_en" placeholder="Title English"><textarea name="content_ar" placeholder="محتوى عربي"></textarea><textarea name="content_en" placeholder="English content"></textarea><button class="save">إنشاء صفحة</button></form><div class="rows"><%pages.forEach(x=>{%><details><summary>/<%=x.slug%> — <%=x.title_ar%></summary><form method="post" action="/admin/pages/save" class="card-form"><input type="hidden" name="id" value="<%=x.id%>"><input name="slug" value="<%=x.slug%>"><input name="title_ar" value="<%=x.title_ar%>"><input name="title_en" value="<%=x.title_en%>"><textarea name="content_ar"><%=x.content_ar%></textarea><textarea name="content_en"><%=x.content_en%></textarea><button class="save">حفظ</button></form><form method="post" action="/admin/pages/delete"><input type="hidden" name="id" value="<%=x.id%>"><button class="danger">حذف</button></form></details><%})%></div></section>

<section id="social" class="panel"><h2>روابط السوشيال ميديا</h2><form method="post" action="/admin/social/save" class="card-form"><input name="name" placeholder="Instagram"><input name="url" placeholder="https://..."><input name="icon" placeholder="instagram"><button class="save">إضافة رابط</button></form><div class="rows"><%socials.forEach(x=>{%><details><summary><%=x.name%></summary><form method="post" action="/admin/social/save" class="card-form"><input type="hidden" name="id" value="<%=x.id%>"><input name="name" value="<%=x.name%>"><input name="url" value="<%=x.url%>"><input name="icon" value="<%=x.icon%>"><button class="save">حفظ</button></form><form method="post" action="/admin/social/delete"><input type="hidden" name="id" value="<%=x.id%>"><button class="danger">حذف</button></form></details><%})%></div></section>
</main></div></body></html>