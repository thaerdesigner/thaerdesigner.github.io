<!doctype html>
<html lang="<%=lang%>" dir="<%=lang==='ar'?'rtl':'ltr'%>">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%=s.siteName%></title><meta name="description" content="<%=lang==='ar'?s.heroText_ar:s.heroText_en%>">
<link rel="stylesheet" href="/site.css">
<style>:root{--primary:<%=s.primary%>;--accent:<%=s.accent%>;--light:<%=s.lightBg%>;--dark:<%=s.darkBg%>;--lt:<%=s.lightText%>;--dt:<%=s.darkText%>}</style>
</head><body class="mode-<%=s.mode%>">
<header class="nav"><a class="brand" href="/"><% if(s.logo){%><img src="<%=s.logo%>" alt="logo"><%}%><span><%=s.siteName%></span></a>
<nav><a href="#services"><%=lang==='ar'?'خدماتنا':'Services'%></a><a href="#about"><%=lang==='ar'?'من نحن':'About'%></a><a href="#portfolio"><%=lang==='ar'?'أعمالنا':'Work'%></a><a href="#contact"><%=lang==='ar'?'تواصل معنا':'Contact'%></a></nav>
<div class="actions"><a href="/?lang=<%=lang==='ar'?'en':'ar'%>"><%=lang==='ar'?'EN':'AR'%></a><button onclick="document.body.classList.toggle('manual-dark')">◐</button></div></header>

<main>
<section class="hero"><div class="hero-copy"><span class="eyebrow"><%=lang==='ar'?s.heroBadge_ar:s.heroBadge_en%></span>
<h1><%=lang==='ar'?s.heroTitle_ar:s.heroTitle_en%></h1><p><%=lang==='ar'?s.heroText_ar:s.heroText_en%></p>
<div class="cta"><a class="btn" href="#portfolio"><%=lang==='ar'?'شاهد أعمالنا ↗':'View our work ↗'%></a><a class="text-link" href="#services"><%=lang==='ar'?'استكشف خدماتنا':'Explore services'%></a></div></div>
<div class="hero-card"><div class="orb"></div><div><b>+12</b><span><%=lang==='ar'?'سنة خبرة':'Years experience'%></span></div><div><b><%=s.consultationPrice%></b><span><%=lang==='ar'?'استشارة تسويقية':'Marketing consultation'%></span></div></div></section>

<section id="services" class="section"><div class="section-head"><span>01 / <%=lang==='ar'?'خدماتنا':'Services'%></span><h2><%=lang==='ar'?'حلول متكاملة، بهوية تصنع الفرق.':'Integrated solutions with an identity that makes a difference.'%></h2></div><div class="grid services"><% services.forEach(x=>{%><article><span class="num">0<%=x.sort_order%></span><h3><%=lang==='ar'?x.title_ar:x.title_en%></h3><p><%=lang==='ar'?x.description_ar:x.description_en%></p></article><%})%></div></section>

<section id="about" class="section split"><div><span>02 / <%=lang==='ar'?'من نحن':'About'%></span><h2><%=lang==='ar'?'خبرة إبداعية، بعقلية تسويقية.':'Creative expertise, marketing mindset.'%></h2></div><div><p><%=lang==='ar'?s.about_ar:s.about_en%></p><div class="ticks"><span>✦ +12 <%=lang==='ar'?'سنة خبرة':'years'%></span><span>✦ <%=lang==='ar'?'حلول مخصصة لكل علامة':'Tailored solutions'%></span><span>✦ <%=lang==='ar'?'خدمة عربية وإنجليزية':'Arabic & English'%></span></div></div></section>

<section id="portfolio" class="section"><div class="section-head"><span>03 / <%=lang==='ar'?'أعمالنا':'Work'%></span><h2><%=lang==='ar'?'أعمال تُظهر ما نستطيع صنعه.':'Work that shows what we can create.'%></h2></div><div class="portfolio"><% portfolio.forEach(x=>{%><a class="work" href="<%=x.url||'#'%>" target="_blank"><img src="<%=x.image%>" alt=""><div><small><%=x.category%></small><h3><%=x.title%></h3><p><%=x.description%></p></div></a><%})%></div></section>

<section id="contact" class="contact"><div><span>04 / <%=lang==='ar'?'تواصل معنا':'Contact'%></span><h2><%=lang==='ar'?'جاهز نبدأ؟ خلّينا نحكي.':'Ready to start? Let’s talk.'%></h2><p><%=lang==='ar'?'أرسل تفاصيل مشروعك، وسنعود إليك بأقرب وقت.':'Send your project details and we will get back to you.'%></p></div><div class="contact-box"><a href="https://wa.me/<%=s.whatsapp%>">WhatsApp · <%=s.phone%> ↗</a><a href="mailto:<%=s.email%>"><%=s.email%> ↗</a></div></section>
</main>
<footer><div><b><%=s.siteName%></b><span><%=lang==='ar'?'نوظِّف خبرتنا لنجاح علامتك التجارية.':'We turn experience into brand success.'%></span></div><div class="socials"><%socials.forEach(x=>{%><a href="<%=x.url%>" target="_blank"><%=x.name%></a><%})%></div><small>© <%=new Date().getFullYear()%> <%=s.siteName%></small></footer>
<script>const saved=localStorage.getItem('theme');if(saved==='dark')document.body.classList.add('manual-dark');</script></body></html>